{
  "functions": {
    "api/start-call.js": {
      "maxDuration": 30
    },
    "api/perplexity-proxy.mjs": {
      "maxDuration": 30,
      "regions": [
        "all"
      ]
    },
    "api/reconcile-payment-intents.js": {
      "maxDuration": 30
    },
    "api/health-check.js": {
      "maxDuration": 30
    },
    "api/synthetic-call-check.js": {
      "maxDuration": 120
    },
    "api/runway-generate.js": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/reconcile-payment-intents",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/health-check",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/synthetic-call-check",
      "schedule": "0 15 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/silver.html",
      "destination": "/rocca.html",
      "permanent": true
    },
    {
      "source": "/silver-feature.html",
      "destination": "/rocca-feature.html",
      "permanent": true
    },
    {
      "source": "/brucelee.html",
      "destination": "/zhouhan.html",
      "permanent": true
    },
    {
      "source": "/brucelee-feature.html",
      "destination": "/zhouhan-feature.html",
      "permanent": true
    },
    {
      "source": "/friday.html",
      "destination": "/kadevoss.html",
      "permanent": true
    },
    {
      "source": "/friday-feature.html",
      "destination": "/kadevoss-feature.html",
      "permanent": true
    },
    {
      "source": "/frankenstein.html",
      "destination": "/tesla.html",
      "permanent": true
    },
    {
      "source": "/frankenstein-feature.html",
      "destination": "/tesla-feature.html",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/hobbs",
      "destination": "/oswald.html"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "POST, OPTIONS, GET"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type, Authorization"
        }
      ]
    }
  ]
}